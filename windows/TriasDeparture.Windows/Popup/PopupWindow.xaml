<Window x:Class="TriasDeparture.Windows.Popup.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TriasDeparture.Windows.Popup"
        x:Name="Root"
        Title="glei"
        Width="360" Height="480"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        ShowActivated="True"
        d:DataContext="{d:DesignInstance local:PopupViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Window.Resources>
        <!-- Line number as accent-colored badge -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Flat list entry -->
        <Style x:Key="ListButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        </Style>

        <DataTemplate x:Key="DepartureRowTemplate" DataType="{x:Type local:DepartureRow}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Badge}">
                    <TextBlock Text="{Binding Line}" Style="{StaticResource BadgeText}" />
                </Border>
                <TextBlock x:Name="Dest" Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                           Text="{Binding Destination}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Min" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding Minutes}" />
                <Ellipse Grid.Column="3" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Fill="#FBBF24" ToolTip="Echtzeit"
                         Visibility="{Binding IsRealtime, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                    <Setter TargetName="Dest" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Dest" Property="Opacity" Value="0.5" />
                    <Setter TargetName="Min" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="Min" Property="Opacity" Value="0.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="StopTemplate" DataType="{x:Type local:StopItem}">
            <Button Style="{StaticResource ListButton}"
                    Command="{Binding DataContext.OpenStopCommand, ElementName=Root}" CommandParameter="{Binding}">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Favorite ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="★" Foreground="#FBBF24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding FavoriteTitle}" FontWeight="SemiBold" FontSize="15"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FavoriteTitle}" />
            </Grid>

            <ItemsControl x:Name="FavoriteList" Margin="0,8,0,0" ItemsSource="{Binding FavoriteRows}"
                          ItemTemplate="{StaticResource DepartureRowTemplate}" Focusable="False" />

            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Right" Text="{Binding FavoriteStatus}"
                       Style="{StaticResource Secondary}" TextWrapping="Wrap" />
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,12" />

        <!-- ── Search ─────────────────────────────────────────────── -->
        <DockPanel Grid.Row="2" LastChildFill="True">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Zurück (Esc)"
                        Command="{Binding BackCommand}" Margin="0,0,6,0"
                        Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}" />
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"
                             Visibility="{Binding ShowStop, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="Haltestelle suchen …" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center"
                               Style="{StaticResource Secondary}" FontSize="14">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource PlaceholderVisibility}">
                                <Binding Path="SearchText" />
                                <Binding Path="ShowStop" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedStop.DisplayName}" FontWeight="SemiBold" FontSize="15"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Margin="2,8,0,0" Style="{StaticResource Secondary}" TextWrapping="Wrap">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource FirstNonEmpty}">
                        <Binding Path="StopStatus" />
                        <Binding Path="SearchStatus" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <ScrollViewer Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Recent stops -->
                    <StackPanel Visibility="{Binding ShowRecent, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Zuletzt" Style="{StaticResource Secondary}" Margin="2,0,0,4" />
                        <ItemsControl ItemsSource="{Binding RecentStops}" ItemTemplate="{StaticResource StopTemplate}" Focusable="False" />
                    </StackPanel>

                    <!-- Search results -->
                    <ItemsControl x:Name="ResultList" ItemsSource="{Binding StopResults}" ItemTemplate="{StaticResource StopTemplate}"
                                  Focusable="False" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Departures of the chosen stop, grouped by line and direction -->
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False"
                                  Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:GroupItem}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Text="{Binding Line}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                               Text="{Binding Label, StringFormat='→ {0}'}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Minutes}" />
                                    <Button x:Name="Star" Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource IconButton}"
                                            Content="&#xE734;" ToolTip="Als Favorit"
                                            Command="{Binding DataContext.MakeFavoriteCommand, ElementName=Root}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanBeFavorite, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="Star" Property="Content" Value="&#xE735;" />
                                        <Setter TargetName="Star" Property="Foreground" Value="#FBBF24" />
                                        <Setter TargetName="Star" Property="ToolTip" Value="Dein Favorit" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
